# Copy to .env.local and fill in.

# Base URL of msandria-darkroom-api, without a trailing slash. The browser calls
# it directly, so the API must list this site's origin in its CORS_ORIGINS.
# Next.js inlines NEXT_PUBLIC_* into the client bundle at build time, so this
# must be set in the hosting provider BEFORE the production build. Without it
# the gallery shows "Failed to fetch photos".
NEXT_PUBLIC_API_URL=http://localhost:3001

# Google OAuth client id, the same value the API has in GOOGLE_CLIENT_ID. It is not a
# secret: it only says which application a token was issued for, and the API checks
# that the token it receives matches it. There is no client secret and no redirect URI
# in this flow; the browser gets a signed ID token and the API verifies it.
# In the Google console, this site's origin must be listed under "Authorized
# JavaScript origins" (http://localhost:3000 in development).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
