# Copy to .env.local and fill in with your Cloudinary credentials.

# Read by next-cloudinary in the browser to build image URLs.
# Next.js inlines NEXT_PUBLIC_* into the client bundle at build time, so this
# must be set in the hosting provider BEFORE the production build. Note the
# build SUCCEEDS without it and bakes in `undefined` — the breakage only shows
# up as broken images in the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only: needed once uploads are implemented. Never prefix these
# with NEXT_PUBLIC_ — that would ship them to the browser.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
